from pathlib import Path
import re

ROOT = Path(__file__).resolve().parents[1]

def path(rel): return ROOT / rel

def rep(rel, old, new, count=1):
    p = path(rel); s = p.read_text()
    n = s.count(old)
    if n != count:
        raise RuntimeError(f'{rel}: expected {count} matches, got {n}: {old[:100]!r}')
    p.write_text(s.replace(old, new, count))

def regex(rel, pattern, repl, count=1, flags=0):
    p=path(rel); s=p.read_text()
    ns,n=re.subn(pattern,repl,s,count=count,flags=flags)
    if n != count:
        raise RuntimeError(f'{rel}: regex expected {count}, got {n}: {pattern[:100]!r}')
    p.write_text(ns)

