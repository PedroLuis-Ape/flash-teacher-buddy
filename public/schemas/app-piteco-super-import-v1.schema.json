{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-piteco.local/schemas/app-piteco-super-import-v1.schema.json",
  "title": "App Piteco Super Import v1",
  "description": "Contrato canônico para importação de pacotes com pastas, listas, idiomas e flashcards.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "declared_totals", "package"],
  "properties": {
    "schema": { "const": "app-piteco-super-import" },
    "version": { "const": "1.0" },
    "declared_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folders", "lists", "cards"],
      "properties": {
        "folders": { "type": "integer", "minimum": 1, "maximum": 200 },
        "lists": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cards": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "folders"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "folders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/folder" }
        }
      }
    }
  },
  "$defs": {
    "languageCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "back"],
      "properties": {
        "front": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "back": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "front_language", "back_language", "declared_card_count", "cards"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "front_language": { "$ref": "#/$defs/languageCode" },
        "back_language": { "$ref": "#/$defs/languageCode" },
        "declared_card_count": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/card" }
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "declared_totals", "lists"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "declared_totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lists", "cards"],
          "properties": {
            "lists": { "type": "integer", "minimum": 1, "maximum": 500 },
            "cards": { "type": "integer", "minimum": 1, "maximum": 20000 }
          }
        },
        "lists": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/list" }
        }
      }
    }
  }
}
